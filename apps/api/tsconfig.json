{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        // esModuleInterop — это флаг, который включает "переходник" между CJS и ESM:
        // он позволяет писать import express from "express" вместо более
        // громоздкого import * as express from "express", даже если сам пакет использует старый стиль экспорта.
        // Это стандартная практика — почти все современные TS-проекты держат этот флаг включённым, так что смело добавляй.
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "moduleResolution": "node",

        // File Layout
        "rootDir": "./src",
        "outDir": "./dist",

        // Environment Settings
        // See also https://aka.ms/tsconfig/module
        "module": "CommonJS",
        "target": "ES2020",
        "types": [],
        // For nodejs:
        // "lib": ["esnext"],
        // "types": ["node"],
        // and npm install -D @types/node

        // Other Outputs
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Style Options
        // "noImplicitReturns": true,
        // "noImplicitOverride": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // "noFallthroughCasesInSwitch": true,
        // "noPropertyAccessFromIndexSignature": true,

        // Recommended Options
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": false,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }

    //    "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
